# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Tooling cache
.northstar/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Packaging
/build/
dist/
site/
.eggs/
*.egg-info/
pip-wheel-metadata/

# Local environment files
.env
.env.*
# 旧版环境文件写入器可能在中断时留下此类临时密钥文件。
..env.*.tmp
!.env.example
deploy.env
ntfy.bootstrap.env
ntfy.bootstrap.env.*
!ntfy.bootstrap.env.example
configs/app.yaml
configs/.app.yaml.tmp.*
# 已废弃但仍可能遗留在旧开发机上的局部覆盖文件；应用会明确拒绝它，
# 仍忽略以防误加入版本库。
configs/app.local.yaml

# Private credentials and client certificates are runtime-only material.  Public
# templates belong in documented ``*.example`` files, never beside live keys.
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# IDE / OS files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
*.code-workspace
.DS_Store
Thumbs.db

# Runtime outputs
logs/
storage/
reports/
/artifacts/
.streamlit/
*.log

# 根目录 datasets 只允许版本化 schema、manifest、样例和 fixture；真实市场或账户数据不入库。
datasets/raw/
datasets/downloads/
datasets/market/
datasets/accounts/

# 备份策略与恢复演练模板可以版本化，真实数据库备份必须位于仓库外。
infra/backup/northstar-quant/*
!infra/backup/northstar-quant/README.md
