# 由 Northstar Quant 部署脚本在显式 bootstrap 时渲染。
# 此文件包含发布令牌；部署后的 server.yml 仅允许 root 与 ntfy 服务账户读取。
base-url: "https://@NTFY_PUBLIC_HOST@"
listen-http: ":80"
cache-file: "/var/lib/ntfy/cache.db"
cache-duration: "@NTFY_CACHE_DURATION@"
auth-file: "/var/lib/ntfy/auth.db"
auth-default-access: "deny-all"
behind-proxy: true
enable-login: true
enable-signup: false
enable-metrics: false
log-level: "info"
log-format: "json"
auth-users:
  - "@NTFY_ADMIN_USERNAME@:@NTFY_ADMIN_PASSWORD_HASH@:admin"
  - "@NTFY_READER_USERNAME@:@NTFY_READER_PASSWORD_HASH@:user"
  - "northstar-publisher:@NTFY_PUBLISHER_PASSWORD_HASH@:user"
auth-access:
  - "@NTFY_READER_USERNAME@:@NORTHSTAR_NTFY_TOPIC@:read-only"
  - "northstar-publisher:@NORTHSTAR_NTFY_TOPIC@:write-only"
auth-tokens:
  - "northstar-publisher:@NORTHSTAR_NTFY_TOKEN@:Northstar Quant publisher"
