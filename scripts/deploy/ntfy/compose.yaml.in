services:
  caddy:
    image: "@NTFY_CADDY_IMAGE@"
    restart: unless-stopped
    init: true
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    ports:
      - "80:80/tcp"
      - "443:443/tcp"
    volumes:
      - "@NTFY_CONFIG_DIR@/Caddyfile:/etc/caddy/Caddyfile:ro"
      - "@NTFY_DATA_DIR@/caddy/data:/data"
      - "@NTFY_DATA_DIR@/caddy/config:/config"
    tmpfs:
      - /tmp
    networks:
      - ntfy_public
      - ntfy_private

  ntfy:
    image: "@NTFY_IMAGE@"
    command: ["serve"]
    user: "@NTFY_SERVICE_UID@:@NTFY_SERVICE_GID@"
    restart: unless-stopped
    init: true
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    volumes:
      - "@NTFY_CONFIG_DIR@/server.yml:/etc/ntfy/server.yml:ro"
      - "@NTFY_DATA_DIR@/ntfy:/var/lib/ntfy"
    tmpfs:
      - /tmp
    networks:
      - ntfy_private
    healthcheck:
      test: ["CMD-SHELL", "wget -q --tries=1 -O - http://127.0.0.1/v1/health | grep -q '\"healthy\":true'"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s

networks:
  ntfy_public:
    driver: bridge
  ntfy_private:
    internal: true
