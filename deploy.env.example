# Linux 部署目标。建议通过 ~/.ssh/config 管理端口和密钥。
DEPLOY_HOST=deploy@example.com

# systemd 与版本目录配置。
APP_NAME=northstar-quant
SERVICE_USER=northstar
SERVICE_HOME=/srv/northstar
SYSTEMD_SERVICE_NAME=northstar-quant

# 运行时可写目录。部署脚本会校验后以 configs/app.example.yaml 为基底，生成每个待发布版本
# 独立的完整 configs/app.yaml，
# 并据此设置目录权限与 systemd 可写白名单；不能写入密钥，也不要同时在活动 .env 配置同名 NORTHSTAR_*_DIR。
# 留空时依次默认到 ${SERVICE_HOME}/${APP_NAME}/shared/{storage,reports,logs,cache,matplotlib}，
# downloads 默认派生为 storage/downloads；可改为独立数据盘，例如 /mnt/northstar-quant/。
# 仅支持 /srv、/var/lib、/var/cache、/var/log、/mnt 或 /data 下的绝对路径。
RUNTIME_STORAGE_DIR=
RUNTIME_DOWNLOADS_DIR=
RUNTIME_REPORTS_DIR=
RUNTIME_LOG_DIR=
RUNTIME_CACHE_DIR=
RUNTIME_MATPLOTLIB_DIR=

# health：只运行部署健康检查；scheduler：长期运行 live scheduler。
# 当前仓库没有 production 画像和 CTP 报单适配器，必须保持 health。
SERVICE_MODE=health

# 可选的私网 Dashboard。默认关闭；设为 1 时部署独立的
# <SYSTEMD_SERVICE_NAME>-dashboard.service。它只监听 127.0.0.1，不会占用 80/443，
# 也不会替换 health 或 scheduler 主服务。访问只能通过 SSH 隧道或受控 VPN。
DASHBOARD_DEPLOY_ENABLED=0

# 服务器 Python 版本及保留发布数量。
PYTHON_VERSION=3.12
KEEP_RELEASES=5
REMOTE_TMP=/tmp

# 可选的私有 ntfy 即时告警服务。默认关闭；开启前必须由运维人员在远程服务器预装 Docker
# 和 Docker Compose。部署脚本不会安装 Docker，也不会连接公共 ntfy.sh。
# NTFY_PUBLIC_HOST 必须是可从手机访问的 HTTPS 公网 FQDN，只填写主机名，不带协议、端口或路径。
NTFY_DEPLOY_ENABLED=0
NTFY_PUBLIC_HOST=
NTFY_ACME_EMAIL=

# 使用固定镜像标签，升级前应先在测试环境验证；不要改为 latest。
NTFY_IMAGE=binwiederhier/ntfy:v2.27.0
NTFY_CADDY_IMAGE=caddy:2.10.2-alpine

# ntfy 的受控服务端配置和持久化数据目录。它们独立于应用 release，普通发布不会重置认证数据。
NTFY_CONFIG_DIR=/etc/northstar-ntfy
NTFY_DATA_DIR=/var/lib/northstar-ntfy
NTFY_CACHE_DURATION=24h
