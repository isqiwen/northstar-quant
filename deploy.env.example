# Linux 部署目标。建议通过 ~/.ssh/config 管理端口和密钥。
DEPLOY_HOST=deploy@example.com

# systemd 与版本目录配置。
APP_NAME=northstar-quant
SERVICE_USER=northstar
SERVICE_HOME=/srv/northstar
SYSTEMD_SERVICE_NAME=northstar-quant

# 运行时可写目录。部署脚本会把这些路径传给发布前命令和 systemd，不能写入密钥。
# 留空时依次默认到 ${SERVICE_HOME}/${APP_NAME}/shared/{storage,reports,logs,cache,matplotlib}，
# downloads 默认派生为 storage/downloads；可改为独立数据盘，例如 /mnt/northstar-quant/。
# 仅支持 /srv、/var/lib、/var/cache、/var/log、/mnt 或 /data 下的绝对路径。
RUNTIME_STORAGE_DIR=
RUNTIME_DOWNLOADS_DIR=
RUNTIME_REPORTS_DIR=
RUNTIME_LOG_DIR=
RUNTIME_CACHE_DIR=
RUNTIME_MATPLOTLIB_DIR=

# health：只运行部署健康检查；scheduler：长期运行 live scheduler。
# 当前仓库没有 production 画像和 CTP 报单适配器，必须保持 health。
SERVICE_MODE=health

# 服务器 Python 版本及保留发布数量。
PYTHON_VERSION=3.12
KEEP_RELEASES=5
REMOTE_TMP=/tmp
