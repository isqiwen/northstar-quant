# Linux 部署目标：仅接受 SSH 别名、user@host 或 user@[IPv6]。端口、密钥和跳板必须
# 通过受管 ~/.ssh/config 管理；先固定目标主机 known-hosts 指纹，控制面不会接受新指纹。
DEPLOY_HOST=deploy@example.com

# Linux 生产身份固定为 northstar-quant / northstar，禁止覆盖系统或第三方 service。
APP_NAME=northstar-quant
SERVICE_USER=northstar
SYSTEMD_SERVICE_NAME=northstar-quant

# 固定 FHS 布局：代码和 current 在 /opt/northstar；
# /etc/northstar/northstar-quant.env 是 root 管理、精确指向 /opt/northstar/current/.env 的规范符号链接。
# 每个 release 的 .env 再链接到 /etc/northstar/releases/<release>.env 的 root:northstar 0640 快照；
# 不存在可从此清单提升或备份的全局活动配置。持久状态、缓存和日志根分别在
# /var/lib/northstar、/var/cache/northstar、/var/log/northstar，且都不从此清单覆盖。
# 下列运行时叶子目录留空时默认为 state/storage、state/downloads、state/reports、
# log/app、cache/runtime、cache/matplotlib。每个值必须恰好是 Northstar 受 root 控制
# 父目录的一层叶子：/var/lib/northstar、/var/cache/northstar、/var/log/northstar、
# /mnt/northstar-quant 或 /data/northstar-quant。不能把一个可写目录嵌套在另一个可写
# 目录下；部署仅在叶子不存在时创建它，现有叶子的所有者与权限不自动修复。不得写入密钥，
# 也不要同时在 release 环境快照配置同名 NORTHSTAR_*_DIR。
RUNTIME_STORAGE_DIR=
RUNTIME_DOWNLOADS_DIR=
RUNTIME_REPORTS_DIR=
RUNTIME_LOG_DIR=
RUNTIME_CACHE_DIR=
RUNTIME_MATPLOTLIB_DIR=

# health：只运行部署健康检查；scheduler：长期运行 live scheduler。
# 当前仓库没有 production 画像和 CTP 报单适配器，必须保持 health。
SERVICE_MODE=health

# 可选的私网 Dashboard。默认关闭；设为 1 时部署独立的
# <SYSTEMD_SERVICE_NAME>-dashboard.service。它只监听 127.0.0.1，不会占用 80/443，
# 也不会替换 health 或 scheduler 主服务。访问只能通过 SSH 隧道或受控 VPN。
DASHBOARD_DEPLOY_ENABLED=0

# 服务器 Python 版本及保留发布数量。
PYTHON_VERSION=3.12
KEEP_RELEASES=5
REMOTE_TMP=/tmp

# 可选的私有 ntfy 即时告警服务。默认关闭；开启前必须由运维人员在远程服务器预装 Docker
# 和 Docker Compose。部署脚本不会安装 Docker，也不会连接公共 ntfy.sh。
# NTFY_PUBLIC_HOST 必须是可从手机访问的 HTTPS 公网 FQDN，只填写主机名，不带协议、端口或路径。
NTFY_DEPLOY_ENABLED=0
NTFY_PUBLIC_HOST=
NTFY_ACME_EMAIL=

# 使用固定镜像标签，升级前应先在测试环境验证；不要改为 latest。
NTFY_IMAGE=binwiederhier/ntfy:v2.27.0
NTFY_CADDY_IMAGE=caddy:2.10.2-alpine

# ntfy 固定使用下列专用根目录；不得改为任意 /etc 或 /var/lib 主机目录。它们独立于应用
# release，普通发布不会重置认证数据。
NTFY_CONFIG_DIR=/etc/northstar-ntfy
NTFY_DATA_DIR=/var/lib/northstar-ntfy
NTFY_CACHE_DURATION=24h
