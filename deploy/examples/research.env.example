# 在 research.local 上使用。nas.local 的 IP 必须可从 Docker 容器访问。
NORTHSTAR_NAS_ADDRESS=
NORTHSTAR_NAS_DATABASE_PORT=15432
NORTHSTAR_NAS_DATABASE_PASSWORD=
NORTHSTAR_STORAGE_ID=
# 共享名称 northstar 不代表导出路径；须从 QNAP 实际 NFS 配置确认。
NORTHSTAR_NFS_EXPORT=
NORTHSTAR_NFS_VERSION=4
NORTHSTAR_NAS_MOUNT=/mnt/northstar

# 该主机将 NFS 挂载为只读；研究临时计算目录保留在本机。
