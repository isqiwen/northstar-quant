# nas.local / Container Station。仅本机初始化使用管理口令，不分发给应用。
NORTHSTAR_NAS_BIND_ADDRESS=
NORTHSTAR_NAS_DATABASE_PORT=15432
NORTHSTAR_NAS_ADMIN_PASSWORD=
# 独立 URL-safe 随机口令，至少 16 字符；分别交给所属应用。
NORTHSTAR_DATA_HUB_DATABASE_PASSWORD=
NORTHSTAR_RESEARCH_DATABASE_PASSWORD=
NORTHSTAR_LIVE_DATABASE_PASSWORD=
# NAS 本地 appdata 卷内的专用空目录，绝不能是客户端 NFS 挂载。
NORTHSTAR_NAS_PGDATA=
# 在 QNAP 创建以下共享后填写实际本地路径，不把共享名称当路径。
# northstar-source / northstar-market / northstar-research / backups
NORTHSTAR_NAS_SOURCE_DIR=
NORTHSTAR_NAS_MARKET_DIR=
NORTHSTAR_NAS_RESEARCH_DIR=
NORTHSTAR_NAS_BACKUP_DIR=
# 分别生成四个不同 UUID；同一共享在各主机配置中使用同一 UUID。
NORTHSTAR_SOURCE_STORAGE_ID=
NORTHSTAR_MARKET_STORAGE_ID=
NORTHSTAR_RESEARCH_STORAGE_ID=
NORTHSTAR_BACKUP_STORAGE_ID=
