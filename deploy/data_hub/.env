# 主机预先准备的持久目录；应用不管理底层存储或挂载。
NORTHSTAR_DATA_HUB_DATABASE_PASSWORD=

NORTHSTAR_SOURCE_MOUNT=/var/lib/northstar/files/source
NORTHSTAR_SOURCE_STORAGE_ID=

NORTHSTAR_MARKET_MOUNT=/var/lib/northstar/files/market
NORTHSTAR_MARKET_STORAGE_ID=

NORTHSTAR_RESEARCH_MOUNT=/var/lib/northstar/files/research
NORTHSTAR_RESEARCH_STORAGE_ID=

NORTHSTAR_BACKUP_MOUNT=/var/lib/northstar/files/backup
NORTHSTAR_BACKUP_STORAGE_ID=

# Tushare token 通过网页设置，保存在 core 本地 credentials 卷，不写入 .env。

# core Data Hub 只读清单接口；两个后端使用相同随机 token（至少 32 字符）。
NORTHSTAR_PUBLICATION_TOKEN=
NORTHSTAR_DATA_DATABASE_NETWORK=northstar-data-storage
NORTHSTAR_PUBLICATION_BIND_ADDRESS=
NORTHSTAR_PUBLICATION_PORT=19083
