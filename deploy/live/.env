# 运行环境：simnow_trading（第一套）、simnow_dev（接口联调）、production（尚未开放）。
NORTHSTAR_LIVE_ENVIRONMENT=simnow_trading


# Live 本地存储，不依赖其他主机；真实口令仅填写到目标主机的运行副本。
NORTHSTAR_LIVE_DATABASE_PASSWORD=123456
NORTHSTAR_LIVE_WEB_PORT=18080
NORTHSTAR_LIVE_API_PORT=19080

# 当前开发容量默认值；按实际主机负载测量调整。
NORTHSTAR_LIVE_KERNEL_MEMORY=1g
NORTHSTAR_LIVE_DATABASE_MEMORY=1g

# northstarctl 自动按应用和 Git 提交设置镜像；手动使用 Compose 时可填写已验证镜像。
NORTHSTAR_LIVE_IMAGE=
NORTHSTAR_LIVE_FRONTEND_IMAGE=

NORTHSTAR_SIMNOW_USER_ID=''
NORTHSTAR_SIMNOW_APP_ID=''
NORTHSTAR_SIMNOW_AUTH_CODE=''
NORTHSTAR_SIMNOW_PASSWORD=''
