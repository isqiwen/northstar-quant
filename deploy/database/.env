# core.local：仅 Data Hub 使用的独立 PostgreSQL 服务，不发布数据库端口。
NORTHSTAR_DATABASE_ADMIN_PASSWORD=
NORTHSTAR_DATA_HUB_DATABASE_PASSWORD=
NORTHSTAR_DATABASE_PGDATA=/var/lib/northstar/postgresql
NORTHSTAR_DATA_DATABASE_NETWORK=northstar-data-storage
# core 上已核验的 NAS 挂载路径；备份与活跃 PGDATA 分离。
NORTHSTAR_SOURCE_MOUNT=/mnt/northstar/source
NORTHSTAR_MARKET_MOUNT=/mnt/northstar/market
NORTHSTAR_RESEARCH_MOUNT=/mnt/northstar/research
NORTHSTAR_BACKUP_MOUNT=/mnt/northstar/backup
NORTHSTAR_SOURCE_STORAGE_ID=
NORTHSTAR_MARKET_STORAGE_ID=
NORTHSTAR_RESEARCH_STORAGE_ID=
NORTHSTAR_BACKUP_STORAGE_ID=

NORTHSTAR_NAS_ADDRESS=nas.local
NORTHSTAR_NFS_VERSION=4
NORTHSTAR_SOURCE_NFS_EXPORT=
NORTHSTAR_MARKET_NFS_EXPORT=
NORTHSTAR_RESEARCH_NFS_EXPORT=
NORTHSTAR_BACKUP_NFS_EXPORT=
