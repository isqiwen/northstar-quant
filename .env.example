# Northstar Quant 唯一环境变量示例
#
# 复制为 .env 后，仅在这一个未跟踪文件中填写密码、令牌和其他敏感值；不要提交 .env。
# 开发、Docker 与 Linux 部署共用这一份声明清单；生产机按需修改值，但不得增删键名。
# 本模板逐项列出所有仍受 NORTHSTAR_ 环境变量支持的运行时设置。空值会沿用安全默认值。
#
# 运行输出目录由 configs/app.yaml 的顶层 runtime 段管理。该文件是唯一活动应用配置；
# configs/app.example.yaml 只展示完整非敏感配置，程序不会读取它。旧的
# NORTHSTAR_STORAGE_DIR、NORTHSTAR_DOWNLOADS_DIR、NORTHSTAR_REPORTS_DIR 与
# NORTHSTAR_LOG_DIR 不再是有效环境变量；若出现在 .env 或系统环境中，应用会拒绝启动。

# PostgreSQL（本地开发与测试）
# just dev-setup（或 scripts/dev/setup.py --initialize-config）会生成
# POSTGRES_PASSWORD 并更新两个数据库 URL；不会打印密码或启用真实交易。
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
NORTHSTAR_DATABASE_URL=postgresql+psycopg://northstar:CHANGE_ME@127.0.0.1:5432/northstar
NORTHSTAR_TEST_DATABASE_URL=postgresql+psycopg://northstar:CHANGE_ME@127.0.0.1:5432/northstar_test

# Python 第三方缓存目录（可选；Linux systemd 部署会由部署配置覆盖）。留空使用系统默认值。
XDG_CACHE_HOME=
MPLCONFIGDIR=

# 基础运行时设置
NORTHSTAR_APP_NAME="Northstar Quant"
NORTHSTAR_ENV=dev
NORTHSTAR_TIMEZONE=Asia/Shanghai
NORTHSTAR_PROJECT_ROOT=.
NORTHSTAR_DEFAULT_PROFILE_ID=cn_futures_daily_trend_offline
NORTHSTAR_PROFILE_CONFIG_DIR=configs/profiles

# 交易安全与本地仿真。ctp 仅有 fake-front 协议骨架，应用仍拒绝真实连接；保持 paper 和 false 才是安全默认值。
NORTHSTAR_BROKER=paper
NORTHSTAR_LIVE_TRADING_ENABLED=false
NORTHSTAR_KILL_SWITCH_ENABLED=false
NORTHSTAR_DEFAULT_CASH=100000
NORTHSTAR_REBALANCE_MIN_TRADE_VALUE=500
NORTHSTAR_PAPER_FILL_PRICE_MODE=close
NORTHSTAR_PAPER_ACCOUNT=paper-account
# 留空时按账户派生并隔离状态文件；显式路径必须位于 YAML 所设 storage 根内。
NORTHSTAR_PAPER_STATE_PATH=
NORTHSTAR_CTP_SIM_ACCOUNT=ctp-sim-account
NORTHSTAR_CTP_SIM_STATE_PATH=
NORTHSTAR_CTP_SIM_CONTRACT_MAPPING_PATH=configs/instruments/ctp_sim.yaml
NORTHSTAR_CTP_CONTRACT_MAPPING_PATH=configs/instruments/ctp.yaml
NORTHSTAR_ORDER_TIMEOUT_SECONDS=300
NORTHSTAR_LIMIT_PRICE_OFFSET_BPS=15
NORTHSTAR_LIMIT_CHASE_MAX_STEPS=3
NORTHSTAR_LIMIT_CHASE_SLEEP_SECONDS=2
NORTHSTAR_LIMIT_CHASE_PER_STEP_TIMEOUT_SECONDS=20
NORTHSTAR_LIMIT_CHASE_FALLBACK_MODE=cancel
NORTHSTAR_EXECUTION_LEASE_TTL_SECONDS=120

# 市场、数据与研究
NORTHSTAR_EXCHANGE_CALENDAR=XSHG
# 真实 CTP 路径必须配置经过授权的数据提供器；留空会让 preflight 失败关闭。
NORTHSTAR_APPROVED_LIVE_DATA_PROVIDERS=
NORTHSTAR_DAILY_TARGET_MAX_AGE_DAYS=4
NORTHSTAR_REPORT_BENCHMARK_SYMBOL=RB_CONT
NORTHSTAR_FUTURES_TREND_LOOKBACK_DAYS=60
NORTHSTAR_TRADING_CURRENCY=CNY

# 即时告警（仅支持私有部署 ntfy；地址、主题与令牌仅保存于未提交的 .env）
NORTHSTAR_ALERT_MODE=console
NORTHSTAR_NTFY_BASE_URL=
NORTHSTAR_NTFY_TOPIC=
NORTHSTAR_NTFY_TOKEN=
NORTHSTAR_NTFY_TIMEOUT_SECONDS=10

# 邮件报告（密码留空；启用前填写本地 .env）
NORTHSTAR_SMTP_HOST=
NORTHSTAR_SMTP_PORT=465
NORTHSTAR_SMTP_USERNAME=
NORTHSTAR_SMTP_PASSWORD=
NORTHSTAR_SMTP_SENDER=
NORTHSTAR_SMTP_USE_SSL=true
NORTHSTAR_REPORT_RECIPIENTS=
NORTHSTAR_REPORT_EMAIL_SUBJECT_PREFIX="Northstar Quant"
NORTHSTAR_REPORT_EMAIL_ATTACH_PDF=true
NORTHSTAR_REPORT_RECAP_EXECUTION_SHORTFALL_ALERT_BPS=20
NORTHSTAR_REPORT_RECAP_RESIDUAL_ABS_ALERT=10
NORTHSTAR_REPORT_RECAP_RESIDUAL_RATIO_ALERT=0.05
NORTHSTAR_REPORT_RECAP_FUNDING_ABS_ALERT=1000
NORTHSTAR_REPORT_RECAP_FUNDING_RATIO_ALERT=0.01

# 真实交易 preflight（即使当前为 paper，也完整列出以便审计）
NORTHSTAR_LIVE_PREFLIGHT_MAX_STATE_AGE_SECONDS=120
NORTHSTAR_LIVE_PREFLIGHT_INTRADAY_DATA_MAX_AGE_MINUTES=120
NORTHSTAR_LIVE_PREFLIGHT_DAILY_DATA_MAX_AGE_DAYS=4
NORTHSTAR_LIVE_PREFLIGHT_WEEKLY_DATA_MAX_AGE_DAYS=10
NORTHSTAR_LIVE_PREFLIGHT_ALLOW_VALUATION_PRICE_FALLBACK=false

# 盘中运行时风控
NORTHSTAR_RUNTIME_RISK_GATE_MAX_AGE_SECONDS=90
NORTHSTAR_RUNTIME_RISK_MAX_STATE_AGE_SECONDS=30
NORTHSTAR_RUNTIME_RISK_MAX_QUOTE_AGE_SECONDS=15
NORTHSTAR_RUNTIME_RISK_MAX_MARGIN_RATIO=0.75
NORTHSTAR_RUNTIME_RISK_MIN_AVAILABLE_FUNDS_RATIO=0.15
NORTHSTAR_RUNTIME_RISK_MAX_QUOTE_SPREAD_BPS=100
NORTHSTAR_RUNTIME_RISK_MAX_OPEN_ORDERS=50

# 调度。cron 中的空格必须保留引号。
NORTHSTAR_SCHEDULER_TIMEZONE=Asia/Shanghai
NORTHSTAR_SHADOW_RUN_CRON="20 15 * * 1-5"
NORTHSTAR_DAILY_SIGNAL_CRON="20 15 * * 1-5"
NORTHSTAR_EXECUTION_CRON="5 9,21 * * 1-5"
NORTHSTAR_RUNTIME_RISK_CRON="*/1 * * * 1-5"
NORTHSTAR_BROKER_SYNC_CRON="0,15,30,45 9-16 * * 1-5"
NORTHSTAR_DAILY_REPORT_CRON="45 16 * * 1-5"
NORTHSTAR_WEEKLY_REPORT_CRON="0 17 * * 5"
NORTHSTAR_MONTHLY_REPORT_CRON="0 17 24-31 * *"
NORTHSTAR_YEARLY_REPORT_CRON="15 17 * 12 *"

# Dashboard 仅允许监听 IPv4 回环地址 127.0.0.1。远程查看通过 SSH 隧道或受控 VPN；
# 程序会拒绝 0.0.0.0、局域网和公网地址，不能以此配置直接暴露 Web 服务。
NORTHSTAR_DASHBOARD_HOST=127.0.0.1
NORTHSTAR_DASHBOARD_PORT=8501
