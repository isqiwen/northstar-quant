# 私有 ntfy 的一次性身份初始化模板。复制为未跟踪的 ntfy.bootstrap.env 后填写；
# 不要在仓库、命令行历史、CI 日志或聊天消息中保存真实值。
#
# 仅在 NTFY_DEPLOY_ENABLED=1 时，通过
#   UPLOAD_ENV=1 UPLOAD_NTFY_BOOTSTRAP=1 SETUP_SERVER=1 scripts/deploy.sh
# 首次上传。普通发布不得设置 UPLOAD_NTFY_BOOTSTRAP=1，以免触发身份初始化流程。
# 可用 NTFY_BOOTSTRAP_FILE=/安全路径/ntfy.bootstrap.env 指定替代文件。

# 服务管理员：仅供人工维护 ntfy，不提供给 Northstar 应用或手机订阅端。
NTFY_ADMIN_USERNAME=
NTFY_ADMIN_PASSWORD=

# 手机订阅者：仅具有告警主题的只读权限，不用于应用发布。
NTFY_READER_USERNAME=
NTFY_READER_PASSWORD=
