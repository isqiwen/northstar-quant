# Northstar Quant's one-command release-gate sudo boundary.
#
# This is a template, not an artifact that normal deployment is permitted to
# install.  A root operator must manually replace `northstar-deploy` with the
# dedicated SSH deployment account, review the root-owned release gate, and
# validate the installed copy with `visudo -cf` before placing it below
# /etc/sudoers.d/.  Do not add shells, Python interpreters, editors, package
# managers, or any staging path to this file.
#
# The fixed wrapper executes the root-owned isolated Python gate.  Only the
# read-only identity check and stdin-only submit verbs are delegated; manual
# recovery remains a root operator action outside sudo.
User_Alias NORTHSTAR_DEPLOYER = northstar-deploy
Cmnd_Alias NORTHSTAR_RELEASE_GATE = /usr/local/libexec/northstar-quant/release-gate identity, \
  /usr/local/libexec/northstar-quant/release-gate submit

NORTHSTAR_DEPLOYER ALL=(root) NOPASSWD: NOSETENV: NORTHSTAR_RELEASE_GATE
