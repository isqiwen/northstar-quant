{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "开发：初始化",
      "detail": "首次自动引导缺失的开发工具（需在终端确认），随后通过 just materialize 依赖、创建或校验本地 paper 配置、验证并复用已运行的原生 PostgreSQL，并只升级至 Alembic head。",
      "type": "process",
      "command": "python",
      "args": [
        "scripts/dev/setup.py",
        "--initialize-workstation"
      ],
      "problemMatcher": []
    },
    {
      "label": "测试：全部",
      "detail": "运行完整 pytest；标准开发初始化已准备本地 PostgreSQL 与前向迁移。",
      "type": "process",
      "command": "python",
      "args": [
        "scripts/dev/run_just.py",
        "test"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "质量：检查",
      "detail": "通过仓库本地 just 运行静态检查；不会执行部署或交易。",
      "type": "process",
      "command": "python",
      "args": [
        "scripts/dev/run_just.py",
        "check"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "开发：环境诊断",
      "detail": "只读检查 Python、uv、just、原生 PostgreSQL、OpenSSH 等工作站依赖。",
      "type": "process",
      "command": "python",
      "args": [
        "scripts/dev/run_just.py",
        "dev-check"
      ],
      "problemMatcher": []
    }
  ]
}
