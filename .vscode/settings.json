{
  "python.envFile": "${workspaceFolder}/.env",
  "python.terminal.useEnvFile": true,
  "python.analysis.extraPaths": [
    "${workspaceFolder}/src"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "tests/application/unit",
    "tests/data/unit",
    "tests/intelligence/unit",
    "tests/research/unit",
    "tests/portfolio_risk/unit",
    "tests/trading_execution/unit",
    "tests/foundation/unit"
  ],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit"
    }
  },
  "files.exclude": {
    "**/.northstar": true,
    "**/.venv": true,
    "**/.venv.bootstrap-*": true,
    "**/.venv.previous-*": true,
    "**/..venv.bootstrap-*": true,
    "**/..venv.previous-*": true,
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.env.before-schema-migration-*": true,
    "**/.env.tmp.*": true,
    "**/logs": true,
    "**/reports": true,
    "**/storage": true
  },
  "files.watcherExclude": {
    "**/.northstar/**": true,
    "**/.venv/**": true,
    "**/.venv.bootstrap-*/**": true,
    "**/.venv.previous-*/**": true,
    "**/..venv.bootstrap-*/**": true,
    "**/..venv.previous-*/**": true,
    "**/reports/**": true,
    "**/storage/**": true
  },
    "cSpell.enabled": true,
  "cSpell.language": "en",
  "cSpell.allowCompoundWords": true,
  "cSpell.useGitignore": true,
  "cSpell.ignorePaths": [
    "**/.git/**",
    "**/build/**",
    "**/out/**",
    "third_party/intel/payload/**"
  ],
  "cSpell.words": [
    "northstar"
  ]
}
