        "NORTHSTAR_MARKET_STORAGE_ID": "00000000-0000-4000-8000-000000000002",
        "NORTHSTAR_RESEARCH_DIR": "${workspaceFolder}/.northstar/vscode/files/research",
        "NORTHSTAR_RESEARCH_STORAGE_ID": "00000000-0000-4000-8000-000000000003",
        "NORTHSTAR_STORAGE_ID": "00000000-0000-4000-8000-000000000001",
        "NORTHSTAR_LOG_DIR": "${workspaceFolder}/.northstar/vscode/logs",
