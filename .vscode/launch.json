        "NORTHSTAR_DATABASE_URL": "postgresql+psycopg://northstar:northstar_local@127.0.0.1:15432/northstar_data_hub_vscode",
        "NORTHSTAR_DATABASE_OWNER": "data_hub",
        "NORTHSTAR_DATA_DIR": "${workspaceFolder}/.northstar/vscode/files/source",
        "NORTHSTAR_LIVE_ENVIRONMENT": "simnow_trading",
        "NORTHSTAR_SIMNOW_USER_ID": "",
        "NORTHSTAR_SIMNOW_APP_ID": "",
        "NORTHSTAR_SIMNOW_AUTH_CODE": "",
        "NORTHSTAR_SIMNOW_PASSWORD": "",
