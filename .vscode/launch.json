{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Northstar: Debug Live Web (port 18180)",
      "type": "debugpy",
      "request": "launch",
      "module": "northstar_quant.cli",
      "args": [
        "serve",
        "live-api",
        "--port",
        "18180"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.vscode/test.env",
      "env": {
        "NORTHSTAR_SIMNOW_CONFIG": "",
        "NORTHSTAR_LIVE_URL": "http://127.0.0.1:18181",
        "NORTHSTAR_LIVE_AUTH": "${workspaceFolder}/.northstar/vscode-runtime-auth/live-web.toml"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Northstar: prepare debug runtimes"
    },
    {
      "name": "Northstar: Debug Live (port 18181)",
      "type": "debugpy",
      "request": "launch",
      "module": "northstar_quant.cli",
      "args": [
        "serve",
        "live-kernel",
        "--port",
        "18181"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.vscode/test.env",
      "env": {
        "NORTHSTAR_DATABASE_URL": "postgresql+psycopg://northstar:northstar_local@127.0.0.1:15432/northstar_quant_vscode",
        "NORTHSTAR_DATA_DIR": "${workspaceFolder}/.northstar/vscode-sources",
        "NORTHSTAR_SIMNOW_CONFIG": "",
        "NORTHSTAR_LIVE_URL": "http://127.0.0.1:18181",
        "NORTHSTAR_LIVE_AUTH": "${workspaceFolder}/.northstar/vscode-runtime-auth/live.toml"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Northstar: prepare debug runtimes"
    },
    {
      "name": "Northstar: Debug current pytest file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-q"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.vscode/test.env",
      "env": {
        "NORTHSTAR_TEST_DATABASE_URL": "postgresql+psycopg://northstar:northstar_local@127.0.0.1:15432/northstar_quant_test",
        "NORTHSTAR_DATABASE_URL": "",
        "NORTHSTAR_DATA_DIR": "",
        "NORTHSTAR_SIMNOW_CONFIG": ""
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Northstar: prepare isolated development databases"
    }
  ],
  "compounds": [
    {
      "name": "Northstar: Debug independent Live and Live Web",
      "configurations": [
        "Northstar: Debug Live Web (port 18180)",
        "Northstar: Debug Live (port 18181)"
      ],
      "stopAll": false,
      "preLaunchTask": "Northstar: prepare debug runtimes"
    }
  ]
}
